local baseplate = workspace:FindFirstChild("Baseplate")

local PLATE_NAME = "VEXZYHUBBaseplate"

local function createBaseplate()
    local existing = workspace:FindFirstChild(PLATE_NAME)
    if existing then
        existing:Destroy()
    end

    local baseplateY = baseplate and (baseplate.Position.Y + (baseplate.Size.Y / 2)) or 0

    local newBaseplate = Instance.new("Part")
    newBaseplate.Name = PLATE_NAME
    newBaseplate.Size = Vector3.new(99999999, 1, 99999999) -- massively bigger
    newBaseplate.Position = Vector3.new(0, baseplateY - 0.5, 0)
    newBaseplate.Anchored = true
    newBaseplate.CanCollide = true
    newBaseplate.Transparency = 1
    newBaseplate.Material = Enum.Material.SmoothPlastic
    newBaseplate.Parent = workspace

    print("Extended baseplate Y:", baseplateY - 0.5)
end

local function removeBaseplate()
    local customBaseplate = workspace:FindFirstChild(PLATE_NAME)
    if customBaseplate then
        customBaseplate:Destroy()
        print("Extended baseplate removed")
    end
end

local isToggleOn = true

if isToggleOn then
    createBaseplate()
else
    removeBaseplate()
end
